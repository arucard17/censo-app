rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /registros/{docId} {
      allow read: if true;
      allow create: if isValidRegistro(request.resource.data);
      allow update, delete: if false;
    }
  }
}

function isValidRegistro(data) {
  return data.keys().hasAll([
      'nombre',
      'celular',
      'sector',
      'estrato',
      'tipoVivienda',
      'dominioVivienda',
      'serviciosPublicos',
      'arraigo',
      'etnia',
      'numPersonas',
      'hombres1859',
      'mujeres1859',
      'hombres60',
      'mujeres60',
      'ninos',
      'ninas',
      'discapacitados',
      'desplazados',
      'reinsertados',
      'lgtbi',
      'estudianEscuela',
      'estudianColegio',
      'estudianUniversidad',
      'trabajanVereda',
      'trabajanBuga',
      'trabajanOtro',
      'desplazamiento',
      'necesidades',
      'acueductoSatisfaccionServicio',
      'acueductoCalidadAgua',
      'acueductoAtencion',
      'acueductoInformacionComunidad',
      'acueductoGestionesInfraestructura',
      'acueductoImportanciaModernizacion',
      'acueductoGestionAlcantarillado',
      'acueductoTransparenciaRecursos',
      'acueductoAspectosMejorar',
      'acueductoParticipacion',
      'acueductoCalificacionJunta',
      'acueductoSugerencias',
      'localId',
      'source',
      'createdAt',
    ])
    && data.nombre is string
    && data.nombre.size() > 0
    && data.nombre.size() <= 200
    && data.celular is string
    && data.celular.size() > 0
    && data.celular.size() <= 30
    && (!('email' in data) || (data.email is string && data.email.size() <= 200))
    && data.sector in ['Sonsito', 'Sonsito Alto', 'Altos de Zanjón Hondo']
    && data.estrato is int
    && data.estrato >= 1
    && data.estrato <= 5
    && data.tipoVivienda in ['Casa', 'Conjunto', 'Casa lote', 'Finca']
    && data.dominioVivienda in ['Propia', 'Arrendo']
    && data.serviciosPublicos is list
    && data.serviciosPublicos.size() <= 20
    && data.arraigo in ['Raizal', 'Migrante', 'Otro']
    && data.etnia in ['Afro', 'Indígena', 'Otro']
    && nonNegInt(data.numPersonas)
    && nonNegInt(data.hombres1859)
    && nonNegInt(data.mujeres1859)
    && nonNegInt(data.hombres60)
    && nonNegInt(data.mujeres60)
    && nonNegInt(data.ninos)
    && nonNegInt(data.ninas)
    && nonNegInt(data.discapacitados)
    && nonNegInt(data.desplazados)
    && nonNegInt(data.reinsertados)
    && nonNegInt(data.lgtbi)
    && nonNegInt(data.estudianEscuela)
    && nonNegInt(data.estudianColegio)
    && nonNegInt(data.estudianUniversidad)
    && nonNegInt(data.trabajanVereda)
    && nonNegInt(data.trabajanBuga)
    && nonNegInt(data.trabajanOtro)
    && data.desplazamiento in ['A Pie', 'En Moto', 'En Carro', 'Vehículo de alquiler']
    && data.necesidades is list
    && data.necesidades.size() <= 20
    && acueductoOptionalEnum(data.acueductoSatisfaccionServicio, [
      'Muy satisfecho', 'Satisfecho', 'Regular', 'Insatisfecho', 'Muy insatisfecho'
    ])
    && acueductoOptionalEnum(data.acueductoCalidadAgua, [
      'Excelente', 'Buena', 'Regular', 'Deficiente', 'Muy deficiente'
    ])
    && acueductoOptionalEnum(data.acueductoAtencion, [
      'Excelente', 'Buena', 'Regular', 'Deficiente', 'Muy deficiente'
    ])
    && acueductoOptionalEnum(data.acueductoInformacionComunidad, [
      'Siempre', 'Casi siempre', 'Algunas veces', 'Rara vez', 'Nunca'
    ])
    && acueductoOptionalEnum(data.acueductoGestionesInfraestructura, [
      'Excelente', 'Buena', 'Regular', 'Deficiente', 'Muy deficiente'
    ])
    && acueductoOptionalEnum(data.acueductoImportanciaModernizacion, [
      'Muy importante', 'Importante', 'Medianamente importante', 'Poco importante', 'Nada importante'
    ])
    && acueductoOptionalEnum(data.acueductoGestionAlcantarillado, [
      'Excelente', 'Buena', 'Regular', 'Deficiente', 'Muy deficiente'
    ])
    && acueductoOptionalEnum(data.acueductoTransparenciaRecursos, [
      'Totalmente de acuerdo', 'De acuerdo', 'Neutral', 'En desacuerdo', 'Totalmente en desacuerdo'
    ])
    && data.acueductoAspectosMejorar is list
    && data.acueductoAspectosMejorar.size() <= 15
    && acueductoOptionalEnum(data.acueductoParticipacion, [
      'Sí', 'No', 'Dependiendo de la actividad'
    ])
    && data.acueductoCalificacionJunta is int
    && data.acueductoCalificacionJunta >= 0
    && data.acueductoCalificacionJunta <= 10
    && data.acueductoSugerencias is string
    && data.acueductoSugerencias.size() <= 3000
    && data.localId is string
    && data.localId.size() <= 64
    && data.source == 'pwa-sonsito'
    && data.createdAt == request.time
    && optionalGps(data);
}

function nonNegInt(n) {
  return n is int && n >= 0 && n <= 1000;
}

function acueductoOptionalEnum(value, allowed) {
  return value is string
    && value.size() <= 80
    && (value.size() == 0 || value in allowed);
}

function optionalGps(data) {
  return !('gpsLatitude' in data)
    || (
      data.gpsLatitude is number
      && data.gpsLongitude is number
      && data.gpsLatitude >= -90
      && data.gpsLatitude <= 90
      && data.gpsLongitude >= -180
      && data.gpsLongitude <= 180
      && (!('gpsAccuracy' in data)
        || (data.gpsAccuracy is number
          && data.gpsAccuracy >= 0
          && data.gpsAccuracy <= 50000))
      && (!('gpsCapturedAt' in data)
        || (data.gpsCapturedAt is string && data.gpsCapturedAt.size() <= 64))
    );
}
